# ─── Claude Code (local-only state) ──────────────────────────────────────────
# Plugin manifest .claude-plugin/plugin.json IS committed (declares the plugin).
# User-local Claude Code settings should NOT be committed.
.claude/settings.local.json
.claude/sessions/
.claude/.tmp/

# ─── BMAD personal config (per-contributor, never shared) ────────────────────
# BMAD v6.5+ splits config into shared (config.yaml, committed) and personal
# (config.user.yaml, gitignored). Each contributor copies the .example template
# and personalizes it locally.
_bmad/config.user.yaml

# ─── Stepper runtime state (regenerable, project-local) ──────────────────────
# state.yaml + run logs are derived from artifacts on disk; recompute on demand.
_bmad-output/.stepper/
_bmad-output/.archive/
_bmad-output/.runs/

# ─── BMAD artifacts policy ───────────────────────────────────────────────────
# We dogfood BMAD to develop this plugin, so planning/implementation artifacts
# ARE the spec — they stay tracked. Only runtime caches above are ignored.
# _bmad/config.yaml                   ← committed (shared project settings)
# _bmad/config.user.yaml.example      ← committed (onboarding template)
# _bmad/config.user.yaml              ← gitignored (personal settings)
# _bmad-output/brainstorming/         ← committed (design docs)
# _bmad-output/planning-artifacts/    ← committed (PRD, architecture)
# _bmad-output/implementation-artifacts/  ← committed (story specs)
# _bmad-output/test-artifacts/        ← committed (test design, traceability)
# _bmad-output/bmb-creations/         ← committed (skill/agent/module designs)

# ─── Misc ────────────────────────────────────────────────────────────────────
.release-state
*.tgz
.npm/
